FROM node:24-alpine AS build

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ARG VITE_MTPROTO_RELAY_URL=wss://wss.itext.ir
ENV VITE_MTPROTO_RELAY_URL=$VITE_MTPROTO_RELAY_URL \
    VITE_MTPROTO_HAS_WS=1 \
    VITE_MTPROTO_HAS_HTTP= \
    VITE_MTPROTO_HTTP= \
    VITE_MTPROTO_HTTP_UPLOAD= \
    VITE_MTPROTO_AUTO=

RUN TWEB_SKIP_CHECKER=1 pnpm exec vite build

FROM nginx:stable-alpine

COPY .docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
